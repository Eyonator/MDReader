{
  "name": "rendl",
  "productName": "Rendl",
  "version": "1.3.1",
  "description": "Rendl — Markdown reader & writer. Write plain. Read beautifully.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:editor": "esbuild build/editor-entry.js build/editor-styles.css --bundle --minify --format=iife --outdir=renderer/vendor",
    "postinstall": "npm run build:editor",
    "dist": "npm run build:editor && electron-builder --win"
  },
  "author": "Vincent van Soelen",
  "license": "MIT",
  "devDependencies": {
    "@toast-ui/editor": "^3.2.2",
    "@toast-ui/editor-plugin-code-syntax-highlight": "^3.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "nl.vansoelen.rendl",
    "productName": "Rendl",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "locales/**",
      "resources/**"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "description": "Markdown-bestand",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown",
        "description": "Markdown-bestand",
        "role": "Editor"
      },
      {
        "ext": "mdown",
        "name": "Markdown",
        "description": "Markdown-bestand",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Rendl-${version}-win.exe"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Rendl-${version}-mac.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "executableName": "rendl",
      "synopsis": "Markdown reader & writer",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Rendl-${version}-linux.${ext}"
    }
  }
}
